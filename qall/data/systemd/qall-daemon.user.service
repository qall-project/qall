[Unit]
Description=Qall daemon

[Service]
Type=simple
ExecStart={binary} --local --host-task-dir={block_registry} --block-registry-dir={block_registry} --artifact-registry-dir={artifact_registry} --host-volumes-root={host_volumes_root}
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=default.target
